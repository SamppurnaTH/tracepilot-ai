# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai -> API keys)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Muse Spark Open via Baseten (optional; hackathon keys only work with this model id)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional enterprise path: an OpenAI-compatible endpoint serving Meta open weights.
# This replaces only the reviewer; the investigator still calls Meta Model API.
# REVIEWER_BASE_URL=https://your-internal-inference.example/v1
# REVIEWER_MODEL=your-deployed-meta-model-id
# REVIEWER_API_KEY=

# Admin plane: bootstrap the first administrator (no default credentials).
# Set a password of at least 12 characters. Accounts persist in runs/admin.sqlite3.
TRACEPILOT_ADMIN_EMAIL=
TRACEPILOT_ADMIN_PASSWORD=
# TRACEPILOT_ADMIN_DB=/persistent/path/admin.sqlite3
# Frontend build environment: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
