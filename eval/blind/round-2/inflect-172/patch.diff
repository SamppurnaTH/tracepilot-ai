+import inflect
+
+
+def test_plural_long_sentence_no_index_error():
+    p = inflect.engine()
+    # Reported input collapsed by dual-compound handling (" for a " loses the "a"),
+    # leaving fewer inflected words than original words, which crashed postprocess.
+    p.plural("I'm only here for a minute, John.")
+
+
+def test_postprocess_mismatched_word_counts_no_index_error():
+    p = inflect.engine()
+    # Directly exercise postprocess with fewer inflected words than orig words
+    # and a capitalized trailing word (triggers the indexing path).
+    p.postprocess("a b John", "x y")
