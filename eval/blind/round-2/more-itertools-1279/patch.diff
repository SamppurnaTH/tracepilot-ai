+++ b/tests/test_regression_falsy_exception.py
@@ -0,0 +1,26 @@
+import pytest
+
+import more_itertools as mi
+
+
+class FalsyException(Exception):
+    def __bool__(self):
+        return False
+
+
+def test_one_too_long_falsy_exception():
+    exc = FalsyException('too long')
+    with pytest.raises(FalsyException):
+        mi.one([1, 2], too_long=exc)
+
+
+def test_one_too_short_falsy_exception():
+    exc = FalsyException('too short')
+    with pytest.raises(FalsyException):
+        mi.one([], too_short=exc)
+
+
+def test_only_too_long_falsy_exception():
+    exc = FalsyException('too long')
+    with pytest.raises(FalsyException):
+        mi.only([1, 2], too_long=exc)
